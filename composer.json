{
  "name": "potsky/laravel-localization-helpers",
  "description": "An artisan command package for easy translation management",
  "authors": [
    {
      "name": "Potsky"
    },
    {
      "name": "Linus Metzler",
      "email": "linus.metzler@gmail.com"
    }
  ],
  "license": "GPL-3.0-or-later",
  "require": {
    "php": "^8.4",
    "illuminate/support": "^12.0 || ^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.11 || ^11.1",
    "pestphp/pest": "^4.7.8",
    "pestphp/pest-plugin-laravel": "^4.1",
    "mockery/mockery": "^1.6.12",
    "laravel/pint": "^1.30.4",
    "rector/rector": "^2.6.1",
    "driftingly/rector-laravel": "^2.5"
  },
  "autoload": {
    "psr-0": {
      "Potsky\\LaravelLocalizationHelpers\\": "src/"
    }
  },
  "autoload-dev": {
    "classmap": [
      "tests/TestCase.php"
    ]
  },
  "scripts": {
    "test": "vendor/bin/pest",
    "lint": "vendor/bin/pint",
    "lint:test": "vendor/bin/pint --test",
    "refactor": "vendor/bin/rector process",
    "refactor:test": "vendor/bin/rector process --dry-run",
    "post-update-cmd": [
      "@composer bump -D"
    ]
  },
  "minimum-stability": "stable",
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Potsky\\LaravelLocalizationHelpers\\LaravelLocalizationHelpersServiceProvider"
      ]
    }
  }
}
